# Copy to .env and fill in. A real environment variable of the same name
# (e.g. set by systemd) always takes precedence over this file.

# Required — from the BYM dev, per the API-consumer announcement.
BYM_API_KEY=

# Optional overrides — defaults shown.
# BYM_BASE_URL=https://server.bymrefitted.com
# BYM_API_VERSION=v1.6.2-beta
# POLL_INTERVAL_SECONDS=600
# HOST=0.0.0.0
# PORT=8081
# STATIC_DIR=app/static
