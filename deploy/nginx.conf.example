# nginx server block for the BYM MR2 Viewer, reverse-proxying everything to
# server.py (default port 8081). Copy this to somewhere like
# /etc/nginx/sites-available/mr2.example.com, edit the two placeholders
# below, symlink it into sites-enabled/, then `sudo nginx -t && sudo systemctl
# reload nginx`.
#
# A subdomain, not a path prefix, is what this file assumes — every asset
# and API path in the app (/styles.css, /app.js, /api/worlds, ...) is
# root-relative, so this subdomain needs to own the whole path space. A
# shared path like example.com/mr2/ would need code changes first (the app
# would have to learn about that prefix) — this config doesn't attempt that.
#
# HTTPS: this only sets up plain HTTP on :80. The standard next step is
# `sudo certbot --nginx -d mr2.example.com`, which rewrites this file in
# place to add the certificate + a :443 server block and an HTTP->HTTPS
# redirect — run that after this config is confirmed working over HTTP.

server {
    listen 80;
    listen [::]:80;
    server_name mr2.example.com;  # <-- change this

    location / {
        proxy_pass http://127.0.0.1:8081;  # <-- change the port if you changed PORT in .env
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # server.py already sends Cache-Control: no-store on every response
        # (see its end_headers() override) — nothing extra needed here.
    }
}
